{
  "name": "northbeam-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "test:integration:staging": "node scripts/test-integration-staging.mjs",
    "agent:preview": "tsx scripts/agent-preview.ts",
    "agent:model-test": "tsx scripts/agent-model-test.ts",
    "agent:demo-journey": "tsx scripts/agent-demo-journey.ts",
    "db:connections": "tsx scripts/db-connections.ts",
    "db:security-check": "tsx scripts/db-security-check.ts",
    "staging:cleanup-test-workspaces": "tsx scripts/cleanup-test-workspaces.ts",
    "staging:load-seed": "tsx scripts/load-seed.ts",
    "staging:perf-measure": "tsx scripts/perf-measure.ts",
    "staging:worker-capacity": "node --expose-gc --import tsx scripts/worker-capacity.ts",
    "staging:cleanup-test-users": "tsx scripts/cleanup-test-users.ts",
    "crm:sweep": "tsx scripts/crm-sweep.ts",
    "crm:deal-sweep": "tsx scripts/crm-deal-sweep.ts",
    "staging:seed-ai-test-contacts": "tsx scripts/seed-ai-test-contacts.ts",
    "staging:remove-ai-test-contacts": "tsx scripts/seed-ai-test-contacts.ts --remove",
    "staging:repair-ai-test-contacts": "tsx scripts/seed-ai-test-contacts.ts --repair",
    "staging:seed-reply-draft": "tsx scripts/seed-reply-draft.ts",
    "admin:set-super-admin": "tsx scripts/set-super-admin.ts",
    "ll:sweep": "tsx scripts/ll-sweep.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "baileys": "7.0.0-rc14",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "googleapis": "^176.0.0",
    "helmet": "^7.1.0",
    "imapflow": "1.7.8",
    "js-tiktoken": "^1.0.21",
    "jszip": "^3.10.2",
    "libphonenumber-js": "1.12.16",
    "mailparser": "3.9.3",
    "mammoth": "^1.13.0",
    "multer": "^2.3.0",
    "nodemailer": "7.0.6",
    "openai": "^7.43.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "unpdf": "^1.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mailparser": "3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "7.0.2",
    "@types/pg": "^8.11.10",
    "ajv": "^8.20.0",
    "eslint": "^9.32.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.11"
  }
}

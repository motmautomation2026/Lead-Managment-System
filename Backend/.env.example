# Northbeam CRM backend — environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# HTTP server
PORT=8787
# Comma-separated list of origins allowed to call this API (the frontend's
# dev server and/or deployed URL). Example: http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Postgres connection string for the Supabase project's database, using a
# role that BYPASSES Row Level Security (the "postgres" role connection
# string from Supabase Project Settings -> Database -> Connection string,
# or the Session Pooler string). RLS stays enabled on every table as
# defense-in-depth for any other client that connects directly; this
# backend is the trusted service that enforces authorization in code
# instead (see src/authMiddleware.ts), the same way Supabase's own
# service_role key does over PostgREST.
#
# DB-3: DATABASE_URL is the TRANSACTION pooler (port 6543): every API request,
# worker query, script and test. DATABASE_SESSION_URL is the SESSION pooler
# (port 5432), used only for session-level state (the WhatsApp session-lock
# clients and the small session pool). If DATABASE_SESSION_URL is blank the
# session users fall back to DATABASE_URL (one startup warning); WhatsApp then
# refuses to start when DATABASE_URL is on port 6543.
DATABASE_URL=postgres://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_SESSION_URL=postgres://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# Postgres connections (API and worker). Supabase's session pooler caps the
# client connections of the whole project (pool_size; 15 on staging), and
# every session connection counts while open, even idle. Keep
#   2 x DB_SESSION_POOL_MAX (API + worker) + 1 per WhatsApp session lock
# below that cap, with room for scripts and the Supabase dashboard. The
# transaction pooler (DB_POOL_MAX, WORKER_DB_POOL_MAX) allows far more clients
# and shares its server connections between them.
# Defaults: 10 / 10 / 2 / 10000 / 15000. Staging uses DB_POOL_MAX=5, WORKER_DB_POOL_MAX=4, DB_SESSION_POOL_MAX=2.
DB_POOL_MAX=10
WORKER_DB_POOL_MAX=10
DB_SESSION_POOL_MAX=2
# E4b: the session pooler's client limit (Supabase → Database → Connection pooling); Settings → WhatsApp warns from it.
SESSION_POOLER_MAX_CLIENTS=15
# Close idle connections after this many ms (0 = never).
DB_IDLE_TIMEOUT_MS=10000
# A query waits this long for a free connection before failing (0 = forever).
DB_CONNECTION_TIMEOUT_MS=15000

# Supabase project URL and service role key, used ONLY to verify the
# access token a request presents (supabase.auth.getUser(token)) so we
# know which authenticated salesperson is calling. Never expose the
# service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for database integration secrets, Baileys auth keys, QR values,
# and retry payloads. Generate once with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# development | production — affects logging verbosity and error detail.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Google Calendar "Connect" button (one shared OAuth app for all workspaces).
# Create the OAuth client once in Google Cloud Console (type: Web application),
# then set all three values together. Leave all blank to make every workspace
# enter its own client credentials instead.
# The redirect URI must match EXACTLY what is registered in Google Cloud:
#   <public backend URL>/api/v1/connections/google-calendar/oauth/callback
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local example: http://localhost:8787/api/v1/connections/google-calendar/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Website contact-form lead intake: POST /api/v1/public/leads
# Set BOTH together, or leave both blank to keep the endpoint disabled (the
# route then does not exist). The website's server sends the key in the
# X-Ingest-Key header; leads land in the workspace given by INGEST_WORKSPACE_ID
# (MOTM is 00000000-0000-0000-0000-000000000001).
# Generate the key with: openssl rand -hex 32   (minimum 32 characters)
# ---------------------------------------------------------------------------
INGEST_API_KEY=
INGEST_WORKSPACE_ID=
# Who owns the leads is NOT configured here: an admin sets revenue rules and a
# default owner in the CRM under Settings -> Lead assignment (per workspace).

# ---------------------------------------------------------------------------
# Knowledge base embeddings (OpenAI). Used by the API and the worker only;
# NEVER put this key in the frontend. Optional: without it, embedding calls
# fail with "OpenAI is not configured" and nothing else is affected.
# The model must produce 1536 dimensions (kb_chunks.embedding is vector(1536)).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AI agent (backend + worker only). Default models when a workspace's agent
# settings leave them blank; there is no built-in default, so the agent defers
# with "No AI model configured" until one is set.
OPENAI_DECISION_MODEL=
OPENAI_GROUNDING_MODEL=
# USD per million tokens for every model above, e.g.
# OPENAI_PRICES_JSON={"model-a":{"inputPer1M":2.5,"cachedInputPer1M":0.25,"outputPer1M":10},"model-b":{"inputPer1M":0.15,"outputPer1M":0.6}}
# A model without a price is never run by the agent loop.
OPENAI_PRICES_JSON=
# Worker only: run the AI agent decision loop (SHADOW drafts only, nothing is
# sent). Off unless exactly "true".
AGENT_RUNNER_ENABLED=false
# Worker only: CRM v2 company sweeper. Links up to 200 contacts per tick that
# were never linked to a company (backfill) or whose inline link failed.
# On unless exactly "false".
CRM_COMPANY_SWEEP_ENABLED=true
# Worker only: CRM v2 deal sweeper. Attaches up to 100 contacts' meetings/proposals
# per tick that have no deal (backfill, or an inline deal hook that failed).
# On unless exactly "false".
CRM_DEAL_SWEEP_ENABLED=true

# ---------------------------------------------------------------------------
# Outbound send (src/worker.ts + src/providers/*).
# ---------------------------------------------------------------------------

# Email has no env settings: an admin saves the SMTP + IMAP mailbox (encrypted)
# in Settings -> Email, and only the worker sends.
# API + worker (E3b-2b): the API's public address for the email open pixel
# (<this>/t/o/<token>.gif), https in production. Blank = open tracking off. Each
# workspace also needs "Track email opens" on (Settings -> Email, default off).
PUBLIC_API_BASE_URL=
# Worker (LL-2): the CRM frontend's address for links in staff alert / digest emails,
# e.g. https://crm.example.com. Blank = the first CORS_ORIGINS entry.
APP_BASE_URL=
# Worker only (D3): seconds between two reads of a workspace's mailbox over IMAP
# (replies, bounces, unsubscribes; read-only, nothing in the mailbox changes). 30-3600.
EMAIL_IMAP_POLL_SECONDS=120

# src/worker.ts poll loop tuning. Defaults are fine for most setups.
WORKER_POLL_INTERVAL_MS=10000
WORKER_BATCH_SIZE=20
# When true, the worker renders and logs each message instead of actually
# sending it (still advances the run, as if the send succeeded) — a safe way
# to rehearse a workflow's full step progression before going live.
WORKER_DRY_RUN=false
